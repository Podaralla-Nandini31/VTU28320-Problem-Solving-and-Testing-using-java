/Title (public class Task9 {  public static void main\(String[] args\) {  Scanner s=new Scanner\(System.in\);  System.out.println\("Enter the numbers:"\);  int num1=s.nextInt\(\);  int num2=s.nextInt\(\);  int sum=\(num1%10\)+\(num2%10\);  System.out.println\("The sum of last digits of two numbers is :"+sum\);  } })
