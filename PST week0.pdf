/Title (TASK8: public class Task8 {  public static boolean isPalindrome\(int num\) {  if \(num < 0\) {  return false;  }  int originalNum = num;   int reversedNum = 0;  while \(num > 0\) {  int lastDigit = num % 10;   reversedNum = \(reversedNum * 10\) + lastDigit;   num = num / 10;   }   return originalNum == reversedNum;  }  public static void main\(String[] args\) {  int testNumber = 12321;)
